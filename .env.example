# ─────────────────────────────────────────────────────
# ALB Mentality — variables d'environnement
#
# La plupart de ces clés peuvent AUSSI être saisies directement dans le site,
# depuis la page /reglages, une fois le site en ligne. Ce fichier sert
# surtout pour Supabase, qui doit être connecté en premier (c'est lui qui
# stocke ensuite les autres clés saisies dans /reglages).
# ─────────────────────────────────────────────────────

# Supabase — obligatoire, à connecter en premier.
# Créer un projet sur supabase.com, exécuter supabase/schema.sql dans l'éditeur SQL,
# puis copier ces deux valeurs depuis Project Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Les clés suivantes sont normalement saisies depuis /reglages une fois le site
# en ligne. Tu peux aussi les mettre ici si tu préfères les gérer par variables
# d'environnement (utile pour un premier test en local).

# Stripe — paiement
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful — fabrication et livraison
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# Resend — envoi des e-mails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OpenAI — vérification automatique des photos envoyées par les clients dans
# le créateur de design (contenu interdit, puis logos/marques protégées).
# Sans cette clé, aucune photo client n'est acceptée (sécurité par défaut).
OPENAI_API_KEY=

# Nom du bucket Supabase Storage où sont conservées les photos clients déjà
# validées par l'IA (voir "Storage" dans le README). Laisser tel quel sauf
# si tu choisis un autre nom de bucket.
SUPABASE_STORAGE_BUCKET=designs-clients

# Mot de passe de la page /reglages (laisser vide : il se définit tout seul
# à la première connexion sur /reglages)
ADMIN_PASSWORD_HASH=
